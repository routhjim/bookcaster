   "depth_m": 0.25,
   "about": "drapes hung at every window after the layout (the period kit's): their full width and depth stand on the floor; nothing stands in the side columns beyond the window, and no tall piece before the window itself. width 0 turns it off."
  },
  "low_under_window_m": 1.0
 },
